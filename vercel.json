{
  "framework": null,
  "buildCommand": "node scripts/build-vercel.cjs",
  "installCommand": "",
  "outputDirectory": "vercel-static",
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.8.0",
      "excludeFiles": "{config/config.php,storage/**,tests/**,database/**,.git/**,.vercel/**,vercel-static/**,public/assets/vendor/**}"
    }
  },
  "routes": [
    { "src": "/assets/(.*)", "dest": "/assets/$1" },
    { "src": "/(.*)", "dest": "/api/index.php" }
  ]
}
